{
  "name": "@saas/agent",
  "version": "1.0.0",
  "private": true,
  "description": "Windows background service to sync TallyPrime with the SaaS cloud platform",
  "type": "module",
  "bin": {
    "tally-agent": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "start": "node ./dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@saas/shared": "workspace:*",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
